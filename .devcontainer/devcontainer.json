{
  "name": "kubernetes",
  "image": "mcr.microsoft.com/devcontainers/go:1",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/kind:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "updateContentCommand": "make WHAT=cmd/kubectl",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
